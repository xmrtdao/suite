# ─────────────────────────────────────────────────────────────
# XMRT Suite — Environment Configuration
# ─────────────────────────────────────────────────────────────
# Two deployment modes:
#
# 1. Supabase Cloud (production)
#    VITE_SUPABASE_URL=https://your-project.supabase.co
#    VITE_SUPABASE_PUBLISHABLE_KEY=eyJ... (anon key)
#    SUPABASE_SERVICE_ROLE_KEY=eyJ... (service_role key)
#    SUPABASE_ACCESS_TOKEN=sbp_... (management token)
#
# 2. Local Supabase (local-sb, dev)
#    VITE_SUPABASE_URL=http://127.0.0.1:54321
#    VITE_SUPABASE_PUBLISHABLE_KEY=local-anon-key
#    SUPABASE_SERVICE_ROLE_KEY=local-dev-service-role-key
#    SUPABASE_ACCESS_TOKEN=local
#
# The frontend reads VITE_* vars at build time. Backend scripts
# read SUPABASE_* vars directly. Both must agree on the target.
# ─────────────────────────────────────────────────────────────

# ── Mode Select (pick ONE set) ──────────────────────────────

## Cloud (uncomment for production)
# VITE_SUPABASE_URL=https://vawouugtzwmejxqkeqqj.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZhd291dWd0endtZWp4cWtlcXFqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTI3Njk3MTIsImV4cCI6MjA2ODM0NTcxMn0.qtZk3zk5RMqzlPNhxCkTM6fyVQX5ULGt7nna_XOUr00
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ACCESS_TOKEN=sbp_02e7562153a72212965749d42b82419b91558022

## Local-sb (default for dev)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=local-anon-key
SUPABASE_SERVICE_ROLE_KEY=local-dev-service-role-key
SUPABASE_ACCESS_TOKEN=local

# ── AI Provider Keys ────────────────────────────────────────
# These are needed for edge functions that call AI APIs directly.
# In cloud mode, most edge functions use the Lovable AI Gateway
# fallback chain and don't need individual keys.
# In local-sb mode, set at minimum one AI key for fallback.

VITE_OPENAI_API_KEY=
VITE_GOOGLE_API_KEY=
VITE_ELEVENLABS_API_KEY=
VITE_HUME_API_KEY=

# ── Environment ─────────────────────────────────────────────
NODE_ENV=development
VITE_APP_VERSION=0.1.0

# ── Feature Flags ───────────────────────────────────────────
VITE_ENABLE_VOICE=true
VITE_ENABLE_CAMERA=true
VITE_ENABLE_PYTHON=true